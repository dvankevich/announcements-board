@baseUrl = http://localhost:3000

### ====================== AUTH ======================

### Login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "olena",
  "password": "securepass123"
}

### Save tokens after login
@accessToken = {{login.response.body.accessToken}}
@refreshToken = {{login.response.body.refreshToken}}

### Refresh tokens
# @name refresh
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Update tokens after refresh
@accessToken = {{refresh.response.body.accessToken}}
@refreshToken = {{refresh.response.body.refreshToken}}

### ====================== ANNOUNCEMENTS ======================

### Get all announcements (default)
GET {{baseUrl}}/api/announcements

### Get announcements - page 2
GET {{baseUrl}}/api/announcements?page=2

### Search by title
GET {{baseUrl}}/api/announcements?search=laptop

### Sort by oldest first
GET {{baseUrl}}/api/announcements?sort=oldest

### Search + pagination
GET {{baseUrl}}/api/announcements?search=sale&page=1

### Search + sort + pagination
GET {{baseUrl}}/api/announcements?search=asus&sort=oldest&page=1

### Empty search
GET {{baseUrl}}/api/announcements?search=

### Invalid page
GET {{baseUrl}}/api/announcements?page=0

### Get announcement by ID
GET {{baseUrl}}/api/announcements/1

### Get announcement by ID (not found)
GET {{baseUrl}}/api/announcements/9999

### Get announcement by ID (invalid id)
GET {{baseUrl}}/api/announcements/abc

### Create announcement
POST {{baseUrl}}/api/announcements
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Selling a mountain bike",
  "description": "Mountain bike, 21 speeds, good condition",
  "price": 8000,
  "category": "sale"
}

### Create announcement - validation error
POST {{baseUrl}}/api/announcements
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Bike",
  "description": "Short",
  "price": -100,
  "category": "invalid"
}

### Update announcement
PATCH {{baseUrl}}/api/announcements/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Selling a mountain bike urgently",
  "price": 6500
}

### Update announcement - empty body
PATCH {{baseUrl}}/api/announcements/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### Delete announcement
DELETE {{baseUrl}}/api/announcements/1
Authorization: Bearer {{accessToken}}

### Delete announcement - not found
DELETE {{baseUrl}}/api/announcements/9999
Authorization: Bearer {{accessToken}}